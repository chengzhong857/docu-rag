# 复制本文件为 .env 后填入，不要把 .env 提交到 git

# --- 大模型（OpenAI 兼容协议，任选一家）---
# DeepSeek:   https://api.deepseek.com/v1        model=deepseek-chat
# 阿里百炼:   https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# 智谱:       https://open.bigmodel.cn/api/paas/v4               model=glm-4-flash
# 本地 vLLM:  http://127.0.0.1:8000/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# --- 检索 ---
EMBED_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=420
CHUNK_OVERLAP=80
TOP_K_VECTOR=12
TOP_K_BM25=12
TOP_K_FINAL=5
HYBRID_ALPHA=0.80

# 可选重排：开启后会下载约 1.1GB 模型，CPU 上单次查询增加 1~2 秒
USE_RERANK=0
RERANK_MODEL=BAAI/bge-reranker-base

# 国内下载模型走镜像
HF_ENDPOINT=https://hf-mirror.com
